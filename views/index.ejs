<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Dot — a clean, minimal link-in-bio page for your links and portfolio.">
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="shortcut icon" href="/images/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <nav class="navbar">
    <div class="brand">
      <img src="/images/logo.svg" alt="Dot">
      Dot
    </div>
    <div class="nav-actions">
      <a href="/dashboard" id="navDashboardLink" class="btn btn-ghost hidden">Dashboard</a>
      <button class="btn" data-open-login>Log in</button>
      <button class="btn btn-primary" data-open-register>Sign up</button>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <div class="dot-mark"><span></span></div>
        <h1>One link.<br>Everything you are.</h1>
        <p>Your links, your work, your world — all in one place that actually looks good. No clutter, no fuss, just you.</p>
        <div class="hero-actions">
          <button class="btn btn-primary" data-open-register>Claim your Dot </button>
          <button class="btn" data-open-login>I already have one</button>
        </div>
      </div>
      <div class="hero-preview">
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-profile">
              <div class="phone-avatar">A</div>
              <div class="phone-name">@yourname</div>
              <div class="phone-bio">builder of things. coffee addict.</div>
            </div>
            <div class="phone-links">
              <div class="phone-link">🔗 My latest project</div>
              <div class="phone-link">📸 Photography</div>
              <div class="phone-link">🎵 Spotify playlist</div>
            </div>
            <div class="phone-portfolio">
              <div class="phone-portfolio-item"></div>
              <div class="phone-portfolio-item"></div>
              <div class="phone-portfolio-item"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="features">
    <div class="feature">
      <div class="num">01</div>
      <h3>All your links, one place</h3>
      <p>Add as many as you want. Reorder them with a drag. Toggle them on and off whenever.</p>
    </div>
    <div class="feature">
      <div class="num">02</div>
      <h3>Show off your work</h3>
      <p>Drop up to 6 images with captions. Perfect for your portfolio, projects, or just cool stuff you made.</p>
    </div>
    <div class="feature">
      <div class="num">03</div>
      <h3>Looks good without trying</h3>
      <p>Sign up, drop your links, done.</p>
    </div>
  </div>

  <footer style="text-align:center; padding: 40px 20px 60px; font-size: 12px; color: var(--light-gray); letter-spacing: 0.05em;">
    <a href="https://maou.name.ng" target="_blank" rel="noopener" style="color: var(--medium-gray); font-weight: 600;">ᗰᗩOᑌ</a>
  </footer>

  <!-- Login Modal -->
  <div class="modal-overlay" id="loginModal">
    <div class="modal">
      <button class="modal-close" data-close-modal>&times;</button>
      <h2>Log in</h2>
      <div class="alert" id="loginAlert"></div>
      <form id="loginForm">
        <div class="field">
          <label for="loginIdentifier">Username or email</label>
          <input type="text" id="loginIdentifier" required autocomplete="username">
        </div>
        <div class="field">
          <label for="loginPassword">Password</label>
          <input type="password" id="loginPassword" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Log in</button>
      </form>
      <div class="modal-switch">Don't have an account? <a href="#" data-open-register>Sign up</a></div>
    </div>
  </div>

  <!-- Register Modal -->
  <div class="modal-overlay" id="registerModal">
    <div class="modal">
      <button class="modal-close" data-close-modal>&times;</button>
      <h2>Create your Dot</h2>
      <div class="alert" id="registerAlert"></div>
      <form id="registerForm">
        <div class="field">
          <label for="registerUsername">Username</label>
          <input type="text" id="registerUsername" required minlength="3" maxlength="30" pattern="[a-z0-9_]+" autocomplete="username">
          <small>Lowercase letters, numbers, underscores only. This is permanent.</small>
        </div>
        <div class="field">
          <label for="registerEmail">Email</label>
          <input type="email" id="registerEmail" required autocomplete="email">
        </div>
        <div class="field">
          <label for="registerPassword">Password</label>
          <input type="password" id="registerPassword" required minlength="6" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create account</button>
      </form>
      <div class="modal-switch">Already have an account? <a href="#" data-open-login>Log in</a></div>
    </div>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>