<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title, description: profile.bio || ((profile.displayName || profile.username) + ' on Dot') }) %>
</head>
<body>

  <div class="public-page">
    <div class="public-top">
      <a href="/" class="brand" aria-label="Dot home">
        <img src="/images/logo.svg" alt="">
        dot
      </a>
      <a href="/" class="btn btn-sm">Make yours</a>
    </div>

    <div class="profile-header" data-reveal>
      <% if (profile.avatarUrl) { %>
        <img class="profile-avatar" src="<%= profile.avatarUrl %>" alt="<%= profile.displayName %>">
      <% } else { %>
        <div class="profile-avatar" aria-hidden="true"><%= (profile.displayName || profile.username).charAt(0).toUpperCase() %></div>
      <% } %>

      <div class="profile-name"><%= profile.displayName || profile.username %></div>
      <% if (profile.bio) { %><div class="profile-bio"><%= profile.bio %></div><% } %>
      <% if (profile.location) { %><div class="profile-location"><%= profile.location %></div><% } %>

      <% const social = profile.social || {}; %>
      <% if (social.twitter || social.github || social.linkedin || social.youtube || social.instagram) { %>
      <div class="social-row">
        <% if (social.twitter) { %><a class="social-icon" href="<%= social.twitter %>" target="_blank" rel="noopener" aria-label="Twitter"><img src="/images/twitter.svg" alt="Twitter" width="18" height="18"></a><% } %>
        <% if (social.github) { %><a class="social-icon" href="<%= social.github %>" target="_blank" rel="noopener" aria-label="GitHub"><img src="/images/github.svg" alt="GitHub" width="18" height="18"></a><% } %>
        <% if (social.linkedin) { %><a class="social-icon" href="<%= social.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn"><img src="/images/linkedin.svg" alt="LinkedIn" width="18" height="18"></a><% } %>
        <% if (social.youtube) { %><a class="social-icon" href="<%= social.youtube %>" target="_blank" rel="noopener" aria-label="YouTube"><img src="/images/youtube.svg" alt="YouTube" width="18" height="18"></a><% } %>
        <% if (social.instagram) { %><a class="social-icon" href="<%= social.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><img src="/images/instagram.svg" alt="Instagram" width="18" height="18"></a><% } %>
      </div>
      <% } %>
    </div>

    <% if (portfolio && portfolio.length) { %>
    <div class="portfolio-grid" data-reveal>
      <% portfolio.forEach(item => { %>
        <% const inner = `
          ${item.imageUrl ? `<img src="${item.imageUrl}" alt="${item.caption || ''}">` : ''}
          ${item.caption ? `<div class="portfolio-caption">${item.caption}</div>` : ''}
        `; %>
        <% if (item.url) { %>
          <a class="portfolio-item" href="<%= item.url %>" target="_blank" rel="noopener"><%- inner %></a>
        <% } else { %>
          <div class="portfolio-item"><%- inner %></div>
        <% } %>
      <% }) %>
    </div>
    <% } %>

    <% if (links && links.length) { %>
    <div class="links-list" data-reveal>
      <% links.forEach((link, i) => { %>
        <a class="link-btn" href="<%= link.url %>" target="_blank" rel="noopener">
          <span class="index-num"><%= String(i + 1).padStart(2, '0') %></span>
          <span><%= link.icon %> <%= link.title %></span>
        </a>
      <% }) %>
    </div>
    <% } %>

    <div class="public-footer">
      <span class="micro-label">dot · link-in-bio</span>
      <div class="flex gap-12">
        <a href="/terms">Terms</a>
        <a href="/privacy">Privacy</a>
        <a href="/cookies">Cookies</a>
        <a href="https://maou.name.ng" target="_blank" rel="noopener">MAOU</a>
      </div>
    </div>
  </div>

  <%- include('partials/consent') %>

  <script src="/js/theme.js"></script>
  <script src="/js/reveal.js"></script>
  <script src="/js/consent.js"></script>
</body>
</html>