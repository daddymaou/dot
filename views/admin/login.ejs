<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Admin Login · Dot', admin: true, showConsent: false }) %>
</head>
<body>

  <div class="error-page">
    <div class="brand" style="justify-content:center;margin-bottom:28px;">
      <img src="/images/logo.svg" alt="">
      dot / admin
    </div>

    <div class="narrow" style="width:100%;max-width:420px;text-align:left;">
      <div class="kicker" style="margin-bottom:24px;">Restricted area · 001</div>
      <div class="alert" id="loginError"></div>
      <form id="adminLoginForm">
        <div class="field">
          <label for="identifier">Username or Email</label>
          <input type="text" id="identifier" name="identifier" placeholder="admin" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block">Sign In</button>
      </form>
      <p style="text-align:center;margin-top:24px;font-size:13px;">
        <a href="/" class="text-muted" style="font-weight:600;">&larr; Back to site</a>
      </p>
    </div>
  </div>

  <script src="/js/theme.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>